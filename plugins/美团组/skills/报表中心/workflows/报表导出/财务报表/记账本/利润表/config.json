{
  "name": "利润表导出",
  "url": "https://pos.meituan.com/web/report/main#/rms-report/profit-statement",
  "description": "查看和导出门店利润表",
  "max_pages": 1,
  "rate_limit": 0.5,
  "selectors": {
    "query_button": "button:has-text('查询')",
    "export_button": "button:has-text('导出')",
    "form_fields": [
      {
        "name": "time_range",
        "type": "daterange",
        "label": "统计时间",
        "required": true
      },
      {
        "name": "store_ids",
        "type": "multiselect",
        "label": "门店选择",
        "required": true
      },
      {
        "name": "report_type",
        "type": "select",
        "label": "报表类型",
        "options": [
          "日报",
          "月报",
          "年报"
        ]
      }
    ]
  }
}