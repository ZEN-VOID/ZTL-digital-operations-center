{
  "name": "菜品叫损统计导出",
  "url": "https://pos.meituan.com/web/report/main#/rms-report/dish-loss-statistics",
  "description": "统计菜品叫起后损耗情况",
  "max_pages": 1,
  "rate_limit": 0.5,
  "selectors": {
    "query_button": "button:has-text('查询')",
    "export_button": "button:has-text('导出')",
    "form_fields": [
      {
        "name": "time_range",
        "type": "daterange",
        "label": "统计时间",
        "required": true
      },
      {
        "name": "store_ids",
        "type": "multiselect",
        "label": "门店选择",
        "required": true
      },
      {
        "name": "dish_category",
        "type": "select",
        "label": "菜品分类",
        "required": false
      }
    ]
  }
}